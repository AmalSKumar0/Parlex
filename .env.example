# Network Listeners
HTTP_ADDR=:8080
INTERNAL_ADDR=127.0.0.1:9090

# Database
DATABASE_URL=postgres://translator:translator_secret@localhost:5432/translator?sslmode=disable
POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=translator_secret

# Security & Authentication
JWT_SIGNING_KEY_FILE=config/jwt_ed25519_key.pem
JWT_ROTATION_KEY_FILE=
ADMIN_API_KEY=change-this-to-a-secure-random-admin-secret-key

# Provider Configuration
# Set PROVIDER_DEFAULT to 'realtime', 'pipeline', or 'mock'
PROVIDER_DEFAULT=realtime
PROVIDER_REALTIME_API_KEY=
PROVIDER_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime/translations
PROVIDER_AUTH_MODE=bearer

# Quotas and Limits
DEVICE_DAILY_MINUTES_LIMIT=60
MAX_TURN_SECONDS=60
DRAIN_TIMEOUT_SECONDS=10
PLAYBACK_ACK_TIMEOUT_SECONDS=30
WS_PING_INTERVAL_SECONDS=15
WS_PONG_TIMEOUT_SECONDS=40
MAX_PROVIDER_SESSIONS=200
PREWARM_TTL_SECONDS=0

# Web Companion App & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info

# Reverse Proxy (Caddy)
DOMAIN=localhost
ACME_EMAIL=admin@example.com
